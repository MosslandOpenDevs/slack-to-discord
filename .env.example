# Slack App-Level Token (xapp-...) — for Socket Mode
# Obtain from: Slack app settings > Basic Information > App-Level Tokens
# Required scope: connections:write
SLACK_APP_TOKEN=xapp-...

# Slack Bot Token (xoxb-...) — for channel/user info lookup
# Obtain from: Slack app settings > OAuth & Permissions > Bot User OAuth Token
# Required scopes: channels:history, channels:read, users:read
SLACK_BOT_TOKEN=xoxb-...

# Discord Webhook URL
# Obtain from: Discord channel settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Optional: forward only specific Slack channel IDs (comma-separated, leave empty for all)
# Example: SLACK_CHANNEL_ALLOWLIST=C01234567,C09876543
SLACK_CHANNEL_ALLOWLIST=

# Optional: fixed display name in Discord (leave empty to use Slack sender name)
DISCORD_USERNAME=

# Optional: log message content to stdout (default: false — content is omitted for compliance)
DEBUG_LOG_CONTENT=false

# Optional: allowed bot IDs (comma-separated, leave empty to block all bot messages)
# Bot IDs start with B — find them in logs
# Example: SLACK_BOT_ALLOWLIST=B01234567,B09876543
SLACK_BOT_ALLOWLIST=
