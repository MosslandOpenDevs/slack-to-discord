{
  "name": "slack2discord",
  "version": "1.0.0",
  "description": "Slack to Discord message bridge via Socket Mode",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --test src/convert.test.ts src/blockkit.test.ts src/payload.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MosslandOpenDevs/slack-to-discord.git"
  },
  "license": "MIT",
  "dependencies": {
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.18.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
